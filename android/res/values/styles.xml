<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A light theme by day and a dark one at night (values-night): the
         WebView reports the same to the page as prefers-color-scheme. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
